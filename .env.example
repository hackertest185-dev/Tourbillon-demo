# PostgreSQL
POSTGRES_USER=tourbillon
POSTGRES_PASSWORD=changeme

# Cloudinary (image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local SMTP capture (Mailpit) — no personal email or password required.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENABLE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@tourbillon.local

# Admin credentials (local dev only)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend URL used for reset/setup email links and CORS defaults
FRONTEND_BASE_URL=http://localhost:3000

# Google Login (Docker Compose); local Development can use .NET User Secrets instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS (comma-separated origins allowed by backend)
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost;127.0.0.1
TRUSTED_PROXY_IPS=
ADMIN_REQUIRE_MFA_FOR_WRITES=false
ALLOW_FIRST_ADMIN_SETUP=false

# HMAC secret used to protect email OTPs at rest. Use a long random value in production.
AUTH_OTP_PEPPER=generate-a-long-random-secret

# AI / LLM (Ollama local dev defaults — override for production)
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
