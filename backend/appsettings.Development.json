{
  "ChatSettings": {
    "DisableLimitInDev": true
  },
  "WatchFinderSettings": {
    "DisableLimitInDev": true
  },
  "Storage": {
    "Provider": "Local"
  },
  "LocalStorage": {
    "PublicBaseUrl": "http://localhost:5248"
  },
  "AiService": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Hangfire": "Information"
      }
    }
  }
}
