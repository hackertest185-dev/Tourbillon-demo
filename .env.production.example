# Production environment variables — Railway (backend, ai-service) and Vercel (frontend).
#
# This file is the record of WHICH variables exist. The real .env is gitignored, so without
# it there is nothing to check a new environment against, and a variable nobody knows about
# is a variable nobody sets. That is not hypothetical: EMBED_BASE_URL was missing from the
# ai-service in production, which silently disabled /embed, and with it vector search and
# the semantic query cache. Nothing errored; the pipeline just fell back to SQL for
# everything and no telemetry said why.
#
# Copy the names, never the values. Leave secrets blank here.

# ─── Railway: backend service ────────────────────────────────────────────────

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Neon PostgreSQL. Needs the pgvector extension for watch and query embeddings.
ConnectionStrings__DefaultConnection=Host=<project>.neon.tech;Database=tourbillon;Username=<user>;Password=<password>;SSL Mode=Require

# Upstash Redis. TLS, so rediss:// not redis://. Holds auth codes, rate limits,
# chat sessions, and the Hangfire job store.
Redis__ConnectionString=rediss://<user>:<password>@<host>:<port>

# Required: long random secret used to HMAC email OTPs before Redis storage.
AuthSecurity__OtpPepper=<long-random-secret>

# The ai-service is private on Railway — no public domain — so this is the internal
# address, not a public URL. Getting this wrong disables every AI feature at once:
# classify, parse, rerank and chat all go through it.
AiService__BaseUrl=http://ai.railway.internal:5000

ALLOWED_ORIGINS=https://<your-frontend-domain>
AllowedHosts=<your-backend-domain>
TRUSTED_PROXY_IPS=<reverse-proxy-ip>
AppSettings__FrontendBaseUrl=https://<your-frontend-domain>
AdminSettings__AllowFirstAdminSetup=false
AdminSecurity__RequireMfaForWrites=true
# Optional comma-separated allowlist for remote scrape/import hosts. Leave empty only
# when every public HTTPS host is intentionally allowed.
Scraping__AllowedHosts=<brand-domain-1>,<brand-domain-2>

# Enforce the daily AI quotas in production. The local docker stack sets these to true.
WatchFinderSettings__DisableLimitInDev=false
ChatSettings__DisableLimitInDev=false
ChatSettings__WarmStarters=true

# Bump to invalidate every cached query result at once, without a code change. Leave unset
# to use the version compiled into QueryCacheService.
# QueryCache__Version=
# QueryCache__MaxAgeDays=30

AWS__AccessKeyId=
AWS__SecretAccessKey=
AWS__Region=ap-southeast-2

Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=

Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

AdminSettings__SeedAdminEmail=

# ─── Railway: ai-service ─────────────────────────────────────────────────────

FLASK_ENV=production

# Generation. The Anthropic key lives here and nowhere else — the .NET backend never calls
# Anthropic directly, it calls this service.
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-haiku-4-5
LLM_API_KEY=

# Optional: cap requests per minute against the model provider.
# LLM_RATE_LIMIT_RPM=0

# Embeddings — REQUIRED IN PRODUCTION, and the variable that was missing.
#
# Anthropic has no embeddings endpoint, so the generation key cannot serve this. The service
# needs a separate OpenAI-compatible /v1/embeddings backend. Leaving EMBED_BASE_URL unset
# while LLM_BASE_URL points at Anthropic makes /embed return 503 and takes vector search and
# the semantic cache down with it, silently.
#
# The stored vectors are 768-dimensional nomic-embed-text (see the vector(768) column on
# QueryCaches and WatchEmbeddings). Serving the same model keeps them usable. Any other model
# means a migration to the new dimension plus re-embedding the whole catalogue.
EMBED_BASE_URL=
EMBED_MODEL=nomic-embed-text
EMBED_API_KEY=

# Pulled by entrypoint.sh for the local Ollama stack only. The production image is
# python:3.12-slim with no Ollama, so this is unused there.
# BASE_LLM_MODEL=qwen2.5:7b

# ─── Vercel: frontend ────────────────────────────────────────────────────────

# Relative — requests go through the Next.js proxy routes in app/api/.
NEXT_PUBLIC_API_URL=/api/backend

# Where those proxy routes forward to. Public Railway domain, with the /api suffix.
BACKEND_INTERNAL_URL=https://<railway-backend-domain>/api

# Demo without AI: hides chat and avoids probing an absent AI service.
# Omit these two flags when deploying the AI service.
NEXT_PUBLIC_AI_ENABLED=false
AI_SERVICE_ENABLED=false

# Set only when deploying the AI service.
# AI_SERVICE_INTERNAL_URL=https://<ai-domain>

NEXT_PUBLIC_STORAGE_PROVIDER=s3
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=<distribution>.cloudfront.net
